    "0 表示只用 CPU。层数越多越快，占用内存也越多。" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 表示只用 CPU。层数越多越快，占用内存也越多。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 means CPU only. More layers are faster, but use more memory."
          }
        },
        "zh-Hant-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 表示僅使用 CPU。層數越多越快，佔用記憶體也越多。"
          }
        },
        "zh-Hant-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 表示僅使用 CPU。層數越多越快，佔用記憶體亦越多。"
          }
        }
      }
